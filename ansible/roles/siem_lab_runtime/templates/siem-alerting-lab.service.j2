[Unit]
Description=Generate and analyze synthetic SIEM telemetry

[Service]
Type=oneshot
User={{ siem_lab_user }}
Group={{ siem_lab_group }}
WorkingDirectory={{ siem_lab_install_dir }}
Environment=MPLCONFIGDIR={{ siem_lab_state_dir }}/matplotlib
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart={{ siem_lab_install_dir }}/venv/bin/python -m siem_lab demo \
    --out {{ siem_lab_state_dir }}/demo --rules {{ siem_lab_config_dir }}/rules.yml \
    --dashboard-config {{ siem_lab_config_dir }}/dashboard.yml --end-now --skip-evaluation
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{ siem_lab_state_dir }}
